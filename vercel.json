{
  "version": 2,
  "builds": [
    { "src": "api/payment.js", "use": "@vercel/node" },
    { "src": "static/*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/payment.js" },
    { "src": "/success", "dest": "/static/success.html" },
    { "src": "/cancel", "dest": "/static/cancel.html" },
    { "src": "/(.*)", "dest": "/static/$1" }
  ],
  "env": {
    "PAY_MODE": "demo",
    "CURRENCY": "CNY",
    "EXCHANGE_RATE": "7.2",
    "SITE_URL": "https://vercel-deploy-psi-kohl.vercel.app"
  }
}
